# Vultr Serverless Inference API Key
VULTR_INFERENCE_API_KEY=your_api_key_here

# Application settings
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# CORS configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Rate limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_SESSION=10/minute
RATE_LIMIT_LLM=30/minute

# Session storage configuration
# Options: "memory" (default, non-persistent) or "redis" (persistent)
STORAGE_TYPE=memory

# Redis configuration (required when STORAGE_TYPE=redis)
# REDIS_URL=redis://localhost:6379/0
# SESSION_TTL_SECONDS=604800  # 7 days

# SSL/HTTPS configuration (optional)
# Uncomment and set paths to enable HTTPS
# SSL_KEYFILE=/path/to/private.key
# SSL_CERTFILE=/path/to/certificate.crt
# SSL_KEYFILE_PASSWORD=optional_password_if_key_is_encrypted
